# FOODLY Fonts CDN - Apache / LiteSpeed Configuration (Hostinger)

# 1. Enable CORS for all font assets (CRITICAL for CDN)
<IfModule mod_headers.c>
    # Allow cross-origin requests for fonts & stylesheets
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|svg)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Header set Access-Control-Allow-Headers "*"
        Header set Cross-Origin-Resource-Policy "cross-origin"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>

    # Immutable 1-Year Caching for Versioned Assets (/v1/, /v2/)
    <FilesMatch "\.(woff2|woff|ttf|otf|eot|svg|zip)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Short Caching for index.html
    <FilesMatch "index\.html$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# 2. Correct MIME Types
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType application/vnd.ms-fontobject .eot
    AddType image/svg+xml .svg
    AddType text/css .css
    AddType application/zip .zip
</IfModule>

# 3. Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/plain application/xml image/svg+xml
</IfModule>

# 4. Security
Options -Indexes
ServerSignature Off
